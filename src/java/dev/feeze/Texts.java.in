package dev.feeze;

import dev.flang.util.ANY;

/*---------------------------------------------------------------------*/


/**
 * This file collects texts used in Feeze.
 *
 * These texts may originate in other documents like the user documentation and
 * are automatically inserted here by the Makefile.
 *
 * @author Fridtjof Siebert (siebert@tokiwa.software)
 */
public class Texts extends ANY
{


  /*-------------------------  static methods  --------------------------*/


  static String tooltiptext(String html)
  {
    return
      """
      <html>
      <div width="380px">
      """
      +
      html
      +
      """
      </div>
      </html>
      """;
  }


  /*----------------------------  constants  ----------------------------*/


  static String START_LOCAL_RECORDER_TOOLTIP = tooltiptext("""
--START_LOCAL_RECORDER_TOOLTIP--
                                                           """);


}
