# usage: in .desktop file, set
#
#   Terminal=true
#   Exec=<FEEZE_HOME>/bin/feeze_desktop
#

set -eu

FEEZE_DESKTOP_CMD=$0
FEEZE_BIN="$(dirname "$(readlink -f "$0")")"
FEEZE="$FEEZE_BIN/feeze"

# run `feeze`, in case of failure keep the terminal window open.
("$FEEZE" || (echo >&2 "\n*** '$FEEZE' failed with rc $?"; sleep infinity))
